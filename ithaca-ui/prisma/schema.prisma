generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]

  orcidId                String?   @unique
  hasCompletedOnboarding Boolean   @default(false)
  department             String?
  institution            String?

  projects    Project[]
  collections Collection[]
  savedGraphs SavedGraph[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  password     String?
  idToken      String?   @db.Text
  accessTokenExpiresAt DateTime?
  scope        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// =============================================================================
// CITATION CLASSIFICATION CACHE
// =============================================================================

model CitationCache {
  id                String   @id @default(cuid())
  citingId          String   // OpenAlex paper ID (e.g., "W2741809807")
  citedId           String   // OpenAlex paper ID
  edgeType          String   // "supports" | "contradicts" | "extends"
  confidence        Float    // 0.0 - 1.0
  snippet           String   @db.Text // Key sentence explaining the relationship
  provider          String   // e.g., "gemini/gemini-2.0-flash" — tracks which model classified it
  contexts          String?  @db.Text // S2 citation context sentences (JSON array)
  s2Intents         String?  // S2 intent labels (comma-separated: "Background,Methodology")
  classifierVersion Int      @default(1) // Bump to invalidate stale cache entries
  createdAt         DateTime @default(now())

  @@unique([citingId, citedId])
  @@index([citingId])
  @@index([citedId])
  @@map("citation_cache")
}

// =============================================================================
// PROJECTS, COLLECTIONS & SAVED GRAPHS
// =============================================================================

model Project {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  color       String       @default("#3b82f6")
  isFavorite  Boolean      @default(false)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  collections Collection[]
  savedGraphs SavedGraph[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
  @@map("project")
}

model Collection {
  id        String   @id @default(cuid())
  title     String
  paperIds  String[] @default([])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
  @@map("collection")
}

model SavedGraph {
  id        String   @id @default(cuid())
  title     String
  query     String
  nodeCount Int      @default(0)
  edgeCount Int      @default(0)
  config    Json?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_graph")
}

// =============================================================================
// API RATE LIMITING (serverless-compatible, DB-backed)
// =============================================================================

model ApiRateLimit {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([windowStart])
  @@map("api_rate_limit")
}
