generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  sessions      Session[]
  accounts      Account[]
  
  // Custom fields
  orcidId       String?   @unique
  hasCompletedOnboarding Boolean @default(false)

  @@map("user") // Optional: map to lower case table names if preferred, but defaults are fine
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  password     String?
  idToken      String?   @db.Text
  accessTokenExpiresAt DateTime?
  scope        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// =============================================================================
// CITATION CLASSIFICATION CACHE
// =============================================================================

model CitationCache {
  id                String   @id @default(cuid())
  citingId          String   // OpenAlex paper ID (e.g., "W2741809807")
  citedId           String   // OpenAlex paper ID
  edgeType          String   // "supports" | "contradicts" | "extends"
  confidence        Float    // 0.0 - 1.0
  snippet           String   @db.Text // Key sentence explaining the relationship
  provider          String   // e.g., "gemini/gemini-2.0-flash" — tracks which model classified it
  contexts          String?  @db.Text // S2 citation context sentences (JSON array)
  s2Intents         String?  // S2 intent labels (comma-separated: "Background,Methodology")
  classifierVersion Int      @default(1) // Bump to invalidate stale cache entries
  createdAt         DateTime @default(now())

  @@unique([citingId, citedId])
  @@index([citingId])
  @@index([citedId])
  @@map("citation_cache")
}

// =============================================================================
// USER DASHBOARD DATA
// =============================================================================

model Project {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isFavorite  Boolean  @default(false)
  
  // Graph Data
  nodes       Json?    // Stored as JSON for now (Sigma graph export)
  edges       Json?
  metadata    Json?    // View state, camera position, etc.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("project")
}

model Collection {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  paperIds    String[] // Array of OpenAlex IDs
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // We can also count papers easily
  paperCount  Int      @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("collection")
}

model Correction {
  id          String   @id @default(cuid())
  userId      String
  sourceNode  String   // OpenAlex ID
  targetNode  String   // OpenAlex ID
  voteType    String   // "supports" | "contradicts" | "extends"
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  comment     String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("correction")
}
